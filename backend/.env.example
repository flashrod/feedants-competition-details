PORT=4000
MONGODB_URI=mongodb://localhost:27017/feedants
# Auth for assignment: client sends x-user-id header. In production replace with JWT.
DEMO_USER_ID=
CORS_ORIGIN=*
SEED_ON_BOOT=false
# Anti-bot write/read limits per IP per minute (writes only guard join/leave).
RATE_LIMIT_WRITE_MAX=300
RATE_LIMIT_READ_MAX=1000
